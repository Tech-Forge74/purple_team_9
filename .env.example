# Copy to .env. Every value here is optional: with none set, Tally runs on
# localStorage and the rule-based chat parser.

# --- LLM proxy (server only; never prefix these with VITE_) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_DAILY_CAP=500

# --- Firebase (public web config; enables live sync between phones) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
